<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>GalaxyStore — Świąteczne etui i pluszaki</title>

    <style>
        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background: #ffffff;
            color: #222;
        }

        header {
            width: 100%;
            padding: 20px 40px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 1px solid #f0f0f0;
            position: sticky;
            top: 0;
            background: white;
            z-index: 10;
        }

        header h1 {
            font-size: 24px;
            font-weight: 600;
        }

        nav a {
            margin-left: 25px;
            text-decoration: none;
            color: #222;
            font-size: 16px;
        }

        .hero {
            padding: 80px 40px;
            text-align: center;
        }

        .hero h2 {
            font-size: 38px;
            margin-bottom: 15px;
        }

        .hero p {
            font-size: 18px;
            color: #666;
        }

        .btn {
            padding: 12px 25px;
            background: black;
            color: white;
            border: none;
            border-radius: 4px;
            font-size: 16px;
            cursor: pointer;
            margin-top: 20px;
            text-decoration: none;
            display: inline-block;
        }

        .products {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            padding: 40px;
            gap: 40px;
        }

        .product {
            width: 260px;
            border: 1px solid #eee;
            border-radius: 10px;
            padding: 18px;
            text-align: center;
        }

        .product img {
            width: 100%;
            border-radius: 10px;
            margin-bottom: 10px;
        }

        .price {
            font-size: 20px;
            margin: 8px 0;
            font-weight: bold;
        }

        footer {
            text-align: center;
            padding: 20px;
            background: #f7f7f7;
            margin-top: 50px;
        }
    </style>

    <script>
        function showSection(id) {
            document.querySelectorAll(".section").forEach(s => s.style.display = "none");
            document.getElementById(id).style.display = "block";
            window.scrollTo(0, 0);
        }
    </script>
</head>

<body>

<header>
    <h1>GalaxyStore</h1>
    <nav>
        <a href="#" onclick="showSection('home')">Home</a>
        <a href="#" onclick="showSection('products')">Produkty</a>
        <a href="#" onclick="showSection('about')">O nas</a>
        <a href="#" onclick="showSection('contact')">Kontakt</a>
    </nav>
</header>

<!-- STRONA GŁÓWNA -->
<div class="section" id="home">
    <div class="hero">
        <h2>Świąteczne etui na telefon i pluszaki</h2>
        <p>Idealne na prezent 🎄 • Szybka wysyłka • Płatność BLIK</p>
        <a class="btn" onclick="showSection('products')">Zobacz produkty</a>
    </div>
</div>

<!-- PRODUKTY -->
<div class="section" id="products" style="display:none;">
    <h2 style="text-align:center; margin-top:30px;">Nasza oferta</h2>

    <div class="products">

        <div class="product">
            <img src="https://via.placeholder.com/260x260?text=Pluszak+Świąteczny" alt="Pluszak">
            <h3>Pluszak CloudBear</h3>
            <div class="price">29,99 zł</div>
            <button class="btn" onclick="showSection('payment')">Kup teraz</button>
        </div>

        <div class="product">
            <img src="https://via.placeholder.com/260x260?text=Pluszak+Mini" alt="Pluszak">
            <h3>Pluszak MiniMoon</h3>
            <div class="price">24,99 zł</div>
            <button class="btn" onclick="showSection('payment')">Kup teraz</button>
        </div>

        <div class="product">
            <img src="https://via.placeholder.com/260x260?text=Etui+Świąteczne" alt="Etui">
            <h3>Świąteczne etui ClearSoft</h3>
            <div class="price">19,99 zł</div>
            <button class="btn" onclick="showSection('payment')">Kup teraz</button>
        </div>

    </div>
</div>

<!-- PŁATNOŚĆ -->
<div class="section" id="payment" style="display:none;">
    <div style="text-align:center; padding:60px 40px;">
        <h2>Płatność BLIK</h2>
        <p>Wyślij kod BLIK na numer:</p>
        <h2>📱 <b>TUTAJ WSTAW NUMER</b></h2>
        <p>Po zaksięgowaniu płatności wysyłka w 24h.</p>
        <a class="btn" onclick="showSection('products')">Wróć do sklepu</a>
    </div>
</div>

<!-- O NAS -->
<div class="section" id="about" style="display:none;">
    <div style="padding:60px 40px; max-width:700px; margin:auto;">
        <h2>O nas</h2>
        <p>GalaxyStore to sklep z świątecznymi pluszakami i etui na telefony.
        Sprzedajemy produkty idealne na prezent i dbamy o szybką wysyłkę.</p>
    </div>
</div>

<!-- KONTAKT -->
<div class="section" id="contact" style="display:none;">
    <div style="padding:60px 40px; max-width:700px; margin:auto;">
        <h2>Kontakt</h2>
        <p>Email: kontakt@galaxystore.pl</p>
        <p>Telefon / BLIK: TUTAJ NUMER</p>
    </div>
</div>

<footer>
    © 2025 GalaxyStore — Wszystkie prawa zastrzeżone.
</footer>

</body>
</html>

